    {
      "id": "travel-roleplay-01",
      "situationId": "travel",
      "title": "Boarding a BMTC Bus to Majestic",
      "titleKannada": "ಮೆಜೆಸ್ಟಿಕ್ ಬಸ್ ಹತ್ತುವುದು",
      "description": "Board a bus, check the route with the conductor, buy a ticket, and alight at the destination.",
      "partnerRole": "ನಿರ್ವಾಹಕ (Conductor)",
      "userRole": "ಪ್ರಯಾಣಿಕ (Commuter)",
      "initialStepId": "s1",
      "steps": {
        "s1": {
          "id": "s1",
          "speaker": "partner",
          "speakerName": "ನಿರ್ವಾಹಕ",
          "kannada": "ಎಲ್ಲಿಗೆ ಹೋಗ್ಬೇಕು ಸಾರ್?",
          "romanization": "Ellige hogbeku saar?",
          "english": "Where do you need to go, sir?",
          "options": [
            {
              "id": "opt1",
              "kannada": "ನಮಸ್ಕಾರ, ಈ ಬಸ್ ಮೆಜೆಸ್ಟಿಕ್‌ಗೆ ಹೋಗುತ್ತಾ?",
              "romanization": "Namaskara, ee bus Majestic-ge hogutta?",
              "english": "Hello, does this bus go to Majestic?",
              "phraseId": "travel-01",
              "nextStepId": "s2"
            },
            {
              "id": "opt2",
              "kannada": "ಒಂದು ಟಿಕೆಟ್ ಕೊಡಿ.",
              "romanization": "Ondu ticket kodi.",
              "english": "Please give one ticket.",
              "phraseId": "travel-05",
              "nextStepId": "s3"
            }
          ]
        },
        "s2": {
          "id": "s2",
          "speaker": "partner",
          "speakerName": "ನಿರ್ವಾಹಕ",
          "kannada": "ಹೌದು, ಮೆಜೆಸ್ಟಿಕ್‌ಗೆ ಹೋಗುತ್ತೆ. ಹತ್ತಿ.",
          "romanization": "Haudu, Majestic-ge hogutte. Hatti.",
          "english": "Yes, it goes to Majestic. Please get in.",
          "options": [
            {
              "id": "opt3",
              "kannada": "ಒಂದು ಟಿಕೆಟ್ ಕೊಡಿ.",
              "romanization": "Ondu ticket kodi.",
              "english": "Please give one ticket.",
              "phraseId": "travel-05",
              "nextStepId": "s3"
            },
            {
              "id": "opt4",
              "kannada": "ಹೋಗಲು ಎಷ್ಟು ಸಮಯ ಬೇಕು?",
              "romanization": "Hogalu eshtu samaya beku?",
              "english": "How much time is needed to go?",
              "phraseId": "travel-07",
              "nextStepId": "s4"
            }
          ]
        },
        "s3": {
          "id": "s3",
          "speaker": "partner",
          "speakerName": "ನಿರ್ವಾಹಕ",
          "kannada": "ಇಪ್ಪತ್ತು ರೂಪಾಯಿ ಆಗುತ್ತೆ. ಚಿಲ್ಲರೆ ಕೊಡಿ.",
          "romanization": "Ippattu roopaayi aagutte. Chillare kodi.",
          "english": "It will be twenty rupees. Please give change.",
          "options": [
            {
              "id": "opt5",
              "kannada": "ಧನ್ಯವಾದಗಳು!",
              "romanization": "Dhanyavaadagalu!",
              "english": "Thank you!",
              "phraseId": "travel-11",
              "nextStepId": "s5"
            }
          ]
        },
        "s4": {
          "id": "s4",
          "speaker": "partner",
          "speakerName": "ನಿರ್ವಾಹಕ",
          "kannada": "ಟ್ರಾಫಿಕ್ ಇಲ್ಲದಿದ್ದರೆ ಅರ್ಧ ಗಂಟೆ ಬೇಕು.",
          "romanization": "Traffic illadiddare ardha gante beku.",
          "english": "If no traffic, half an hour is needed.",
          "options": [
            {
              "id": "opt6",
              "kannada": "ಒಂದು ಟಿಕೆಟ್ ಕೊಡಿ.",
              "romanization": "Ondu ticket kodi.",
              "english": "Please give one ticket.",
              "phraseId": "travel-05",
              "nextStepId": "s3"
            }
          ]
        },
        "s5": {
          "id": "s5",
          "speaker": "partner",
          "speakerName": "ನಿರ್ವಾಹಕ",
          "kannada": "ಮುಂದೆ ಮೆಜೆಸ್ಟಿಕ್ ಬರುತ್ತೆ, ರೆಡಿಯಾಗಿ.",
          "romanization": "Munde Majestic barutte, ready aagi.",
          "english": "Majestic comes next, get ready.",
          "options": [
            {
              "id": "opt7",
              "kannada": "ಇಲ್ಲಿ ಇಳಿಯಬೇಕು, ದಯವಿಟ್ಟು ನಿಲ್ಲಿಸಿ.",
              "romanization": "Illi iliyabeku, dayavittu nillisi.",
              "english": "I need to get down here, please stop.",
              "phraseId": "travel-03",
              "nextStepId": "s6"
            }
          ]
        },
        "s6": {
          "id": "s6",
          "speaker": "partner",
          "speakerName": "ನಿರ್ವಾಹಕ",
          "kannada": "ಸರಿ ಸಾರ್, ನಿಧಾನವಾಗಿ ಇಳಿಯಿರಿ. ಶುಭ ದಿನ!",
          "romanization": "Sari saar, nidhaanavaagi iliyiri. Shubha dina!",
          "english": "Okay sir, alight slowly. Have a good day!"
        }
      }
    },

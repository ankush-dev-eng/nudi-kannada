  "phrases": [
    {
      "id": "travel-01",
      "situationId": "travel",
      "kannada": "ನಮಸ್ಕಾರ, ಈ ಬಸ್ ಮೆಜೆಸ್ಟಿಕ್‌ಗೆ ಹೋಗುತ್ತಾ?",
      "romanization": "Namaskara, ee bus Majestic-ge hogutta?",
      "english": "Hello, does this bus go to Majestic?",
      "note": "Majestic (Kempegowda Bus Station) is Bengaluru's central transit hub. 'Hogutta?' is the colloquial question for 'does it go?'.",
      "formality": "polite",
      "tags": ["transit", "bus", "direction"],
      "reviewed": false
    },
    {
      "id": "travel-02",
      "situationId": "travel",
      "kannada": "ಮುಂದಿನ ನಿಲ್ದಾಣ ಯಾವುದು?",
      "romanization": "Mundina nildana yaavudu?",
      "english": "Which is the next stop?",
      "note": "'Nildana' means station or stop. 'Mundina' means next.",
      "formality": "polite",
      "tags": ["transit", "inquiry"],
      "reviewed": false
    },
    {
      "id": "travel-03",
      "situationId": "travel",
      "kannada": "ಇಲ್ಲಿ ಇಳಿಯಬೇಕು, ದಯವಿಟ್ಟು ನಿಲ್ಲಿಸಿ.",
      "romanization": "Illi iliyabeku, dayavittu nillisi.",
      "english": "I need to get down here, please stop.",
      "note": "Use 'iliye-beku' when signaling the conductor or driver that you wish to alight.",
      "formality": "polite",
      "tags": ["transit", "action"],
      "reviewed": false
    },
    {
      "id": "travel-04",
      "situationId": "travel",
      "kannada": "ಮೆಟ್ರೋ ನಿಲ್ದಾಣ ಎಲ್ಲಿದೆ?",
      "romanization": "Metro nildana ellide?",
      "english": "Where is the metro station?",
      "note": "'Ellide?' is the universal question for 'where is it?'.",
      "formality": "polite",
      "tags": ["metro", "direction"],
      "reviewed": false
    },
    {
      "id": "travel-05",
      "situationId": "travel",
      "kannada": "ಒಂದು ಟಿಕೆಟ್ ಕೊಡಿ.",
      "romanization": "Ondu ticket kodi.",
      "english": "Please give one ticket.",
      "note": "'Kodi' is polite for 'give'. 'Kodu' is casual.",
      "formality": "polite",
      "tags": ["ticket", "bus"],
      "reviewed": false
    },
    {
      "id": "travel-06",
      "situationId": "travel",
      "kannada": "ಇಲ್ಲಿಂದ ಎಷ್ಟು ದೂರ?",
      "romanization": "Illinda eshtu doora?",
      "english": "How far is it from here?",
      "note": "'Illinda' means from here, 'eshtu doora' means how much distance.",
      "formality": "casual",
      "tags": ["distance", "navigation"],
      "reviewed": false
    },
    {
      "id": "travel-07",
      "situationId": "travel",
      "kannada": "ಹೋಗಲು ಎಷ್ಟು ಸಮಯ ಬೇಕು?",
      "romanization": "Hogalu eshtu samaya beku?",
      "english": "How much time is needed to go?",
      "note": "'Beku' expresses requirement or need.",
      "formality": "polite",
      "tags": ["time", "navigation"],
      "reviewed": false
    },
    {
      "id": "travel-08",
      "situationId": "travel",
      "kannada": "ಈ ರಸ್ತೆಯಲ್ಲಿ ನೇರವಾಗಿ ಹೋಗಿ.",
      "romanization": "Ee rasteyalli neravaagi hogi.",
      "english": "Go straight on this road.",
      "note": "'Neravaagi' means straight.",
      "formality": "polite",
      "tags": ["direction"],
      "reviewed": false
    },
    {
      "id": "travel-09",
      "situationId": "travel",
      "kannada": "ಬಲಗಡೆ ತಿರುಗಿ.",
      "romanization": "Balagade tirugi.",
      "english": "Turn right.",
      "note": "'Bala' means right side in Kannada.",
      "formality": "polite",
      "tags": ["direction"],
      "reviewed": false
    },
    {
      "id": "travel-10",
      "situationId": "travel",
